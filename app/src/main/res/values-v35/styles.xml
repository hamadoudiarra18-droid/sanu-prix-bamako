    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#0B2A7A</item>
        <item name="android:colorPrimaryDark">#0B2A7A</item>
        <item name="android:colorAccent">#A8730F</item>
        <item name="android:statusBarColor">#0B2A7A</item>
        <item name="android:windowBackground">#F3F2EE</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
